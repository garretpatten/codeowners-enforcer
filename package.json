{
  "name": "codeowners-enforcer",
  "author": "Garret Patten",
  "version": "1.3",
  "description": "GitHub Action: enforce that pull request file changes resolve to a CODEOWNERS owner in .github/CODEOWNERS",
  "private": true,
  "keywords": [
    "github-actions",
    "codeowners",
    "pull-request",
    "ci",
    "repository-health"
  ],
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garretpatten/codeowners-enforcer.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/garretpatten/codeowners-enforcer#readme",
  "scripts": {
    "build": "ncc build src/action.ts --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:prettier": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint -c .yamllint.yaml ."
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^5.0.5",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "smol-toml": "^1.9.0",
    "katex": "^0.18.2",
    "markdown-it": "^15.0.3",
    "undici": "^6.29.1",
    "js-yaml": {
      "argparse": "^2.0.0"
    }
  }
}
